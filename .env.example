# ==========================================================
# Python_Base 环境变量示例文件（.env.example）
# ==========================================================
# 用法：
#   1. 复制本文件为 .env        ->  Windows: copy .env.example .env
#                                 Linux/macOS: cp .env.example .env
#   2. 把下面所有 <...> 占位符替换成你自己的真实值
#   3. 不要修改本文件里的「键名」，代码是按这些名字读取的
#
# 重要：
#   * 本文件是**脱敏模板**，只含键名与占位符，可以安全提交到 Git。
#   * 真正的 .env 含密钥/密码，已被 .gitignore 排除（规则见第 28 行 .env），
#     千万不要把 .env 提交上去，也不要把真实密钥写回本文件。
#   * 所有子项目（RAG / Agent / ...）统一读取根目录这一份 .env，
#     加载逻辑见根目录 config.py（pydantic-settings，不区分大小写）。
#
# 键名一览对应关系（config.py 中的读取前缀）：
#   无前缀  -> _CoreSettings   （LLM、数据库、Redis、Milvus、通用配置）
#   APP_    -> AppSettings     （Web 应用监听地址）
#   LLM_    -> LLMSettings     （RAG 大模型）
#   EMBEDDING_ / RERANK_ / RETRIEVAL_ -> RAG 检索链路三段式配置
#   REDIS_ / MILVUS_ / PADDLEOCR_     -> RAG 依赖的外部服务
# ==========================================================

# ==================== LLM 模型配置（全局） ====================

# OpenAI 兼容接口（任何 OpenAI 兼容网关都可以，改 BASE_URL 即可）
# 注意：BASE_URL 要写到 /v1 这一级，不要带具体接口路径
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 备用模型示例: OPENAI_MODEL=gpt-4o

# DeepSeek 官方接口
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== Agent 课案扁平配置 ====================
# Agent 目录下的示例代码统一使用 API_KEY / BASE_URL / MODEL_NAME 这三个名字

API_KEY=sk-your-agent-api-key
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# LangGraph 持久化（短期记忆 / 长期记忆）使用的 PostgreSQL 连接串
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 用户名 / 密码 / 库名属于敏感信息，仓库里一律留空，只在本地 .env 里填写。
PG_URI=

# Langfuse（可观测平台：追踪 / 评估；未申请就留空，留空时相关代码自动跳过）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Agent 课案里额外用到的第三方平台（_jxsd 版代码用；没有就留空，代码会自动跳过并提示）
#   百度千帆：课案「多 Agent / 子Agent」的联网搜索 MCP
BAIDU_QFAN_API_KEY=
#   Gitee：课案「多 Agent / 路由与合并」的代码仓库 MCP
GITEE_API_KEY=
#   阿里云百炼（DashScope）：课案「监控与评估 / RAG评估」的评测模型
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼「原生」API 基址（语音识别 / 声音复刻 / 视频合成 / 临时文件上传用）
# ⚠️ 与上面的 DASHSCOPE_BASE_URL 是两套不同接口，不能互换，混用会 404：
#     DASHSCOPE_BASE_URL = OpenAI 兼容模式，路径 /compatible-mode/v1
#     DASHSCOPE_API_BASE = 原生 DashScope API，路径 /api/v1
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1
# 可选：百炼「业务空间专属域名」的 Workspace ID。
# 填了就切到 https://{ID}.cn-beijing.maas.aliyuncs.com/api/v1
#（部分模型——如爱诗 PixVerse 视频对口型——文档只给这种专属域名形式；留空用通用域名）
DASHSCOPE_WORKSPACE_ID=

# ==================== 数据库配置（全局） ====================
#
# 约定（重要）：仓库里只写「IP + 默认端口」，且 IP 只能是 127.0.0.1；
# 用户名 / 口令 / 库名等其它信息一律留空，只在本地 .env 里填写。
# 下面的空值就是让你在 .env 中补全的，不要把真实值写回本文件。

# MySQL（默认端口 3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# PostgreSQL（默认端口 5432）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis（默认端口 6379）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 无密码：redis://127.0.0.1:6379/0
# 有密码：redis://:你的密码@127.0.0.1:6379/0   ← 只写在本地 .env 里
REDIS_URL=redis://127.0.0.1:6379/0

# Milvus 向量数据库（默认端口 19530）
MILVUS_URI=http://127.0.0.1:19530
# token 格式为 用户名:密码，属于敏感信息，仓库里留空
MILVUS_TOKEN=
# default 是 Milvus 内置的默认库名，不是自定义信息，可以保留
MILVUS_DB=default

# ==================== RAG 项目配置 ====================

# 应用 (App)：FastAPI + Chainlit 服务监听地址
APP_HOST=127.0.0.1
APP_PORT=8099
# 允许跨域的前端源（逗号分隔）。**留空 = 不挂 CORSMiddleware**：
# 本服务只给同源 Chainlit 页面与本地脚本用，默认不对外开放跨域。
APP_CORS_ORIGINS=
# 启动预热：把 FAQ 预设问法向量与 BM25 语料在启动时加载好（布尔值：true/false，默认 true）。
# 置 false 可让启动更快（测试/CI），代价是首个未命中请求要现算预设向量。
APP_WARMUP=true

# 问答缓存总开关（键名与课案一致；布尔值：true/false，默认 true）。
# 置 false ⇒ 四条 RAG 线路都**不读也不写**缓存，用于评估/排障时量真实链路能力。
QA_CACHE_ENABLED=true

# 大模型 (LLM)：RAG 回答生成用的模型
LLM_API_KEY=sk-your-llm-api-key
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# 是否开启思考模式（布尔值：true/false）
LLM_ENABLE_THINKING=true

# 评估 / 评判模型（可选，但与课案要求相关）：专门给 Ragas 四指标与 LLM 评分用
#   为什么要单独配：评判如果用生成回答的那个模型，它会给自己的答案打分偏高（自我偏好），
#   分数系统性乐观。课案明确要求"评估模型与生成模型分开配置"。
#   留空 EVAL_LLM_MODEL ⇒ 回退到上面的 LLM_*，并打一条 WARNING（行为与不配置时完全一致）。
#   EVAL_LLM_API_KEY / EVAL_LLM_BASE_URL 也允许留空：逐项回退 LLM_*（同一家网关换模型时
#   不必把密钥再填一遍）。
EVAL_LLM_MODEL=
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MAX_TOKENS=4096
EVAL_LLM_TIMEOUT=180

# token 成本单价（可选）：用于评估报告里的成本估算（优化篇要求"质量与成本一起看"）
#   单位＝货币单位 / 百万 token，与厂商报价单一致；全留 0 ⇒ 只报 token 真数、**不报成本**
#   （刻意不内置价目表：价格会变、而且本项目走网关，内置的表迟早变成错误信息）。
USAGE_PRICE_INPUT_PER_MILLION=0
USAGE_PRICE_OUTPUT_PER_MILLION=0
# 命中提示缓存的输入单价；留 0 则按普通输入价算
USAGE_PRICE_CACHED_INPUT_PER_MILLION=0
USAGE_CURRENCY=CNY

# 向量化模型 (Embedding)：把文本转成向量，维度要和 MILVUS 集合定义一致
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_SIZE=1024
EMBEDDING_BATCH_SIZE=32

# 重排序模型 (Rerank)：对召回结果精排，取前 TOP_K 条
RERANK_API_KEY=sk-your-rerank-api-key
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
RERANK_TOP_K=8
# 相关性阈值：低于该分数视为不相关
RERANK_RELEVANCE_P=0.65

# 检索配置 (Retrieval)：双路召回合并后保留的候选数量
RETRIEVAL_TOP_N=10

# Redis 缓存（与上面的全局 Redis 是同一个实例，只是多了缓存策略参数）
# 精确命中缓存的有效期（秒）
REDIS_EXACT_TTL=600
# 语义相似度阈值：高于该值视为命中相似问题缓存
REDIS_SIM_THRESHOLD=0.85

# 向量数据库 (Milvus，与上面的全局 Milvus 是同一个实例)
# 用户名 / 口令 / 库名 / 集合名都属于「数据库的其它信息」，仓库里留空，
# 只在本地 .env 里填写。
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=
MILVUS_COLLECTION=

# OCR 服务 (PaddleOCR)：票据 / 图片转 Markdown
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_TOKEN=your-paddleocr-token
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

# ==================== 通用配置 ====================

# 运行环境：development / testing / production
APP_ENV=development
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ==================== 自媒体 Agent（Media_Agent 子项目） ====================
# 对应课案《3.自媒体Agent》。课案原本本地部署了 3 个模型
#   （FunASR 语音识别 / Fish-Speech 声音克隆 / HeyGem 数字人），
# 本项目全部替换为阿里云百炼的托管 API —— 本机不需要 GPU，也不下载任何模型权重。
#
# 复用约定（重要，不要重复配密钥）：
#   · 文本 LLM 直接复用上面的 API_KEY / BASE_URL / MODEL_NAME
#   · 百炼相关直接复用上面的 DASHSCOPE_API_KEY / DASHSCOPE_API_BASE
#   · 下面 MEDIA_* 只放自媒体项目「特有」的东西（模型名 / 音色 / 目录 / 爬虫地址）
#
# 降级约定：缺密钥的链路会自动降级并打印中文提示，应用整体仍能启动；
#           把对应 key 填上即切回真实链路。
#
# ⚠️ 地域：语音识别 / 声音复刻 / 视频对口型都**只在华北2（北京）**提供，
#    必须使用该地域的 API Key，否则报地域不匹配。

# ---- 文本模型（可选覆盖；留空 = 复用上面的 MODEL_NAME）----
MEDIA_LLM_MODEL=
MEDIA_DEEPAGENT_MODEL=

# ---- 模型路由：整条自媒体链路换服务商（可选）----
# 留空 = 复用上面的 API_KEY / BASE_URL / MODEL_NAME（默认）。
# 填 deepseek = 改用本文件已有的 DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL。
#
# 为什么用这个开关、而不是直接改上面的 API_KEY / BASE_URL：
#   根配置是 RAG 与 Agent 课案**共用**的，动它会连带影响别的子项目。
# ⚠️ deepseek-flash 是推理模型：max_tokens 给小了会全被 reasoning 吃光，
#   content 返回空串（实测 max_tokens=300 时必空）。
MEDIA_LLM_PROVIDER=

# ---- 语音识别 ASR（替代课案的本地 FunASR）----
# 开通：https://bailian.console.aliyun.com/  模型市场
MEDIA_ASR_MODEL=qwen-audio-3.0-asr-flash
MEDIA_ASR_LANGUAGE=zh
# 音频转 Base64 内嵌的上限（字节）；超过则先上传百炼临时存储、换成 oss:// URL 再识别。
# 不写（或注释掉）即用默认值 10485760（10MB）
# MEDIA_ASR_INLINE_MAX_BYTES=10485760

# ---- TTS 语音合成（替代课案的本地 Fish-Speech）----
# 开通：https://bailian.console.aliyun.com/  模型市场  CosyVoice
MEDIA_TTS_ENABLED=true
MEDIA_TTS_MODEL=cosyvoice-v2
MEDIA_TTS_FALLBACK_VOICE=zh-CN-XiaoxiaoNeural
# 克隆音色的缓存文件（CosyVoice 建音色有配额，必须复用，不能每次重建）。
# 不写（或注释掉）即用默认值 Media_Agent/.cache/voices.json
# MEDIA_VOICE_CACHE_FILE=

# ---- 数字人对口型（替代课案的本地 HeyGem）----
# ⚠️ 需先在百炼控制台搜索 PixVerse 并点「立即开通」；仅华北2（北京）地域。
MEDIA_AVATAR_MODEL=pixverse/pixverse-lipsync
# 数字人任务最长等待秒数（异步任务，官方说 1~5 分钟）。
# 不写（或注释掉）即用默认值 900
# MEDIA_AVATAR_TIMEOUT=900

# ---- 图片生成（可选，留空即降级为本地占位图）----
MEDIA_IMAGE_API_KEY=
MEDIA_IMAGE_BASE_URL=
MEDIA_IMAGE_MODEL=

# ---- 热点抓取（NewsNow 聚合 API，公共接口无需密钥）----
MEDIA_TRENDRADAR_API_URL=https://newsnow.busiyi.world/api/s

# ---- 数据复盘：抖音作品数据采集 ----
# 自托管 Evil0ctal/Douyin_TikTok_Download_API，启动：
#   cd Media_Agent/deploy && docker compose -f douyin-api.compose.yml up -d
# ⚠️ 别用镜像默认的 start.sh —— 它 uvicorn 开着 reload，本机实测服务起不来。
MEDIA_DOUYIN_API_BASE=http://127.0.0.1:8080
# 抖音登录 Cookie（采集本人主页数据需要）。留空则用手动粘贴数据入口。
# 浏览器登录 www.douyin.com → F12 → Network → 复制任一 douyin.com 请求的 Cookie 整条值。
MEDIA_DOUYIN_COOKIE=

# ---- 运行时目录与素材（注释掉即用 Media_Agent/.cache 下的默认绝对路径）----
# MEDIA_VIDEO_OUTPUT_DIR=
# MEDIA_IMAGE_OUTPUT_DIR=
# MEDIA_AVATAR_INPUT_DIR=
# MEDIA_MASHUP_WORK_DIR=
# 视频剪辑背景音乐路径，留空则不混音
MEDIA_BGM_PATH=
# 剪辑动画素材的生成方式：
#   false（默认）= moviepy 直接画（不碰 HyperFrames）
#   true         = 课案原方案，HyperFrames 渲染 HTML/GSAP
# HyperFrames 依赖 puppeteer 下载浏览器；本机实测 `npx hyperframes init/render`
# 会卡到超时（CLI 的 --version/--help 正常，卡在渲染链路），故默认关。
MEDIA_MASHUP_USE_HYPERFRAMES=false
# 声音克隆的参考音频公网 URL（可选）。
# ⚠️ 实测：百炼 create_voice 只收真正的 http(s)，临时存储的 oss:// 会被拒
#    （400 InvalidParameter: audio url should start with http or https），
#    所以声音克隆这一环必须自己提供公网托管（阿里云 OSS / 你的公网服务器 / 内网穿透）。
# 不配也不影响数字人：会自动降级到 edge-tts 通用音色 / PixVerse 内置 TTS。
MEDIA_VOICE_REF_URL=
# ---- 公网素材托管（声音克隆 / 数字人的硬前提，见 tools/asset_host.py）----
# 为什么需要：百炼 CosyVoice 的 create_voice **不收 oss:// 临时存储**（实测 400：
#   audio url should start with http or https），只认真正的 http(s)。
# 做法：本地素材 scp 到自己的服务器静态目录，nginx 只读分发。
# nginx 侧只需一个 location（上传走 scp，不需要写权限）：
#   location /media-assets/ { alias /var/www/media-assets/; autoindex off; }
# 三项齐备才生效；不配则声音克隆自动降级到 edge-tts 通用音色。
# ⚠️ 文件上传后是公网可读的，别放私密素材（用完可 asset_host.unpublish 删掉）。
# 形如 ubuntu@<你的服务器IP>
MEDIA_ASSET_SSH=
MEDIA_ASSET_REMOTE_DIR=/var/www/media-assets
# 形如 http://<你的服务器IP>/media-assets
MEDIA_ASSET_BASE_URL=
