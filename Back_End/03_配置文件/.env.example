# ============================================================
# .env.example —— 环境变量示例文件（可以安全提交到 Git）
# ============================================================
# 用法：复制一份改名为 .env，填入自己的真实值。
#       .env 里放敏感信息，必须写进 .gitignore，绝不能提交。
#
# 命名规则：全大写 + 下划线；pydantic-settings 默认【不区分大小写】，
#           所以 app_name 字段可以读 APP_NAME 这个环境变量。
# 值的写法：字符串可以加引号（有空格/特殊字符时必须加），数字和布尔不用加。
# ============================================================

# ---------- 应用基础信息 ----------
APP_NAME="我的后端应用"
APP_ENV=development           # development / testing / production
DEBUG=true                    # 布尔值：true/false/1/0/yes/no 都能被正确解析
PORT=8000                     # 会被 pydantic 自动转换成 int

# ---------- 数据库 ----------
# SQLite（本课案默认，零依赖，无需启动任何服务）
DATABASE_URL="sqlite:///./data/app.db"
# MySQL（需要本地已启动 MySQL 并建好库）
# DATABASE_URL="mysql+pymysql://user:password@127.0.0.1:3306/my_database?charset=utf8mb4"

# ---------- 管理员与安全 ----------
ADMIN_EMAIL="admin@example.com"
# 生产环境必须换成随机长字符串，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET="please-change-me-to-a-random-secret"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- 日志 ----------
LOG_LEVEL=INFO                # DEBUG / INFO / WARNING / ERROR
LOG_DIR=./data/logs

# ---------- 外部服务（本机未启动时程序会自动降级，不会报错） ----------
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"
